{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:linters", 
    ":dependencyDashboard",
    "docker:enableMajor",
    "docker:pinDigests"

  ],
  "ignorePresets": [],
  "semanticCommits": "disabled",
  "platformAutomerge": false,
  "prConcurrentLimit": 10,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "ignorePaths": [
      ".forgejo/workflows/*"
  ]
}
