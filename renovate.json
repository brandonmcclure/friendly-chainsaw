{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
      "config:best-practices",
      ":approveMajorUpdates",
      "group:postcss",
      "group:linters", 
      ":dependencyDashboard"
    ],
    "ignorePresets": [
      ":semanticPrefixFixDepsChoreOthers",
